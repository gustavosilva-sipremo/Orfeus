{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orfeus",
  "version": "1.6.1",
  "identifier": "app.orfeus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orfeus",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../ffmpeg/ffmpeg-2026-10-15-git-afead44165-full_build/bin/ffmpeg.exe": "runtime/ffmpeg.exe",
      "windows/cache/python-3.12.10-amd64.exe": "runtime/python-installer.exe",
      "windows/cache/xorriso.exe": "runtime/xorriso.exe",
      "windows/cache/xorriso-GPL-3.0.txt": "runtime/xorriso-GPL-3.0.txt",
      "windows/xorriso-source.txt": "runtime/xorriso-source.txt",
      "windows/setup-path.ps1": "runtime/setup-path.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Orfeus",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
